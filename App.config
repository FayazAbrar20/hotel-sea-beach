<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <connectionStrings>
        <!-- ".\SQLEXPRESS" is the SQL Server Express instance on this computer.
             Change Data Source / Initial Catalog here if your setup differs. -->
        <add name="HotelDb"
             connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=LoginDB;Integrated Security=True;Encrypt=False"
             providerName="System.Data.SqlClient" />
    </connectionStrings>
</configuration>
